# Copy to .env for local development. In production, set these in your host's dashboard.

# Local development: DEBUG=true needs no SECRET_KEY and uses SQLite.
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# For the Django admin site (/django-admin/) behind HTTPS, e.g. https://api.fleetflowservice.com
CSRF_TRUSTED_ORIGINS=

# PostgreSQL in production, e.g. postgres://user:password@host:5432/fleetflow
DATABASE_URL=

# Shared secret with the Next.js frontend (its API_KEY variable). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# With it, rate limits apply per website visitor instead of to the whole frontend server.
FRONTEND_API_KEY=

# Public URL of this API, used for links to uploaded images.
PUBLIC_BASE_URL=http://localhost:8000

# Optional: Redis for rate-limit counters when running several worker processes.
REDIS_URL=

# Optional: store uploaded images in S3 or an S3-compatible service (Cloudflare R2, Backblaze B2, …).
# Credentials are read from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_CUSTOM_DOMAIN=

# Email. The API sends all of the website's emails (team notifications and customer confirmations).
# With RESEND_API_KEY they go through Resend (https://resend.com); otherwise, with EMAIL_HOST, through
# SMTP; otherwise they are printed to the console.
RESEND_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Sender; its domain must be verified with the email provider (SPF/DKIM DNS records).
EMAIL_FROM=FleetFlow <noreply@fleetflowservice.com>
# Where team notifications go (comma-separated).
NOTIFY_EMAIL=operations@fleetflowservice.com
# The website's public URL, for "Open the admin" links in team emails.
SITE_URL=https://fleetflowservice.com
# Taxi customers get no email by default: the team confirms each ride personally.
SEND_BOOKING_CONFIRMATION=false
COMPANY_REPLY_TO=
COMPANY_PHONE=+48 453 505 286
# FleetFlow Cargo's contact details, shown in the cargo quote confirmation.
CARGO_WHATSAPP=+48 516 684 320
CARGO_EMAIL=operations@fleetflowservice.com

# Rate limits per visitor (requests with an admin token are never limited).
THROTTLE_BOOKINGS=10/hour
THROTTLE_CONTACT=10/hour
THROTTLE_ENQUIRIES=10/hour
THROTTLE_LOGIN=20/hour

# Number of reverse proxies in front of the API (1 on most platforms).
NUM_PROXIES=1
